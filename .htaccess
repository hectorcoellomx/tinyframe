RewriteEngine On
Options All -Indexes

# Proteger .htaccess y archivos sensibles
<FilesMatch "^(\.htaccess|\.env.*|docs\.html)$">
    Require all denied
</FilesMatch>

# Bloquear acceso directo a código interno
RewriteRule ^app/ - [F,L,NC]
RewriteRule ^core/ - [F,L,NC]
RewriteRule ^create(/|$) - [F,L,NC]

# Redirigir la raíz del sitio (/) a la ruta 'home'
RewriteRule ^$ index.php?route=home [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/assets/
RewriteCond %{REQUEST_URI} !^/upload/
RewriteRule ^([0-9a-zA-Z-_@./]+)$ index.php?route=$1 [QSA,L]